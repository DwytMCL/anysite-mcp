{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["es2023"],
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["server.js", "selfcheck.js", "lib/**/*.js", "sites/**/*.js", "scripts/**/*.js", "test/**/*.js", "types/**/*.d.ts"]
}
