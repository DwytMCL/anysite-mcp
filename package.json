    "claude",
    "claude-code",
    "cursor",
    "chrome",
    "playwright",
    "accessibility",
    "notebooklm",
    "gemini",
    "web-scraping",
    "no-api-key"
  ],
  "license": "MIT",
  "homepage": "https://github.com/DwytMCL/anysite-mcp#readme",
  "bugs": {
    "url": "https://github.com/DwytMCL/anysite-mcp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DwytMCL/anysite-mcp.git"
  },
