{
  "name": "anysite-mcp",
  "version": "0.3.0",
  "description": "Your AI agent learns a website once and keeps it as a tool: a real Chrome signed in as you, one profile per site, self-repairing shortcuts, record mode and per-site permissions. For Claude, Cursor and any MCP client",
  "mcpName": "io.github.DwytMCL/anysite-mcp",
  "main": "server.js",
  "type": "module",
  "bin": {
    "anysite-mcp": "server.js"
  },
  "scripts": {
    "test": "node selfcheck.js"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "browser",
    "browser-automation",
    "web-automation",
    "automation",
    "ai-agent",
    "ai-agents",
    "claude",
    "claude-code",
    "cursor",
    "chrome",
    "playwright",
    "accessibility",
    "notebooklm",
    "gemini",
    "web-scraping",
    "no-api-key"
  ],
  "license": "MIT",
  "homepage": "https://github.com/DwytMCL/anysite-mcp#readme",
  "bugs": {
    "url": "https://github.com/DwytMCL/anysite-mcp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DwytMCL/anysite-mcp.git"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "server.js",
    "lib/",
    "sites/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "playwright-core": "^1.64.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "typescript": "7.0.2"
  }
}
